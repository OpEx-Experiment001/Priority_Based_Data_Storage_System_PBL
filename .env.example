# -----------------------------------------------------------------------------
# Priority-Based Data Storage System - Configuration
# -----------------------------------------------------------------------------

# Pluggable Storage Engine: 'json' (NoSQL document store, zero host setup) or 'mysql'
STORAGE_ENGINE=json
JSON_STORAGE_PATH=./data_store/storage.json

# MySQL Settings (Active when STORAGE_ENGINE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_NAME=priority_storage
DB_POOL_SIZE=8

# Security & IAM Configuration
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRATION_HOURS=24
ADMIN_DEFAULT_PASSWORD=Admin@123

# Server & Network Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Hardware & Serial Communication
SERIAL_BAUD=9600
ENABLE_VIRTUAL_HARDWARE=true
VIRTUAL_INTERVAL_MS=1200

# Operating System Worker Thread Management
MIN_WORKERS=2
MAX_WORKERS=6
SCALE_UP_QUEUE_DEPTH=10
SCALE_DOWN_QUEUE_DEPTH=2

# Task Processing & Retry Settings
MAX_ATTEMPTS=3
SIMULATED_PROCESS_SECONDS=0.1
